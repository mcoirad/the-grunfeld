{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:4321/the-grunfeld/",
        "http://127.0.0.1:4321/the-grunfeld/executives/moreyda99x/"
      ],
      "numberOfRuns": 1,
      "startServerCommand": "npm run preview -- --host 127.0.0.1 --port 4321",
      "startServerReadyPattern": "Local|Preview server|server running at",
      "startServerReadyTimeout": 120000,
      "settings": {
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
