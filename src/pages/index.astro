---
import "@fontsource-variable/archivo";
import "@fontsource/league-gothic";
import "../styles/global.css";
import { RankingsExplorer } from "../components/RankingsExplorer";
import { loadExecutiveSnapshot } from "../lib/data";
import { rankExecutives } from "../lib/ranking";

const { executives, metadata } = loadExecutiveSnapshot();
const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const heroExecutives = rankExecutives(executives, "current", "bpm")
  .filter(({ portrait }) => portrait)
  .slice(0, 11);
const updatedDate = new Intl.DateTimeFormat("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
}).format(new Date(metadata.generatedAt));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Front Office, Ranked: a data-led ranking of the people who build NBA teams."
    />
    <meta name="theme-color" content="#050505" />
    <meta property="og:title" content="Front Office, Ranked" />
    <meta
      property="og:description"
      content="The drafts, trades, and signings behind the NBA’s front offices—ranked."
    />
    <meta property="og:type" content="website" />
    <link rel="icon" href={`${basePath}favicon.svg`} type="image/svg+xml" />
    <title>Front Office, Ranked — The Grunfeld</title>
  </head>
  <body>
    <a class="skip-link" href="#rankings">Skip to rankings</a>

    <header class="site-header">
      <a class="wordmark" href={basePath} aria-label="The Grunfeld home">
        <span>The</span> Grunfeld
      </a>
      <nav aria-label="Primary navigation">
        <a href="#rankings">Rankings</a>
        <a href="#methodology">Methodology</a>
      </nav>
      <p>Advanced stats for unadvanced managers.</p>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__meta">
          <span>2026 front office index</span>
          <span>Updated {updatedDate}</span>
        </div>

        <div class="hero__portraits" aria-hidden="true">
          {heroExecutives.map((executive, index) => (
            <div class="hero__portrait" style={`--portrait-index: ${index}`}>
              <img
                src={`${basePath}${executive.portrait}`}
                alt=""
                width="520"
                height="520"
                loading="eager"
                decoding="async"
                fetchpriority={index < 5 ? "high" : "auto"}
              />
            </div>
          ))}
        </div>

        <div class="hero__title-frame">
          <p>The people who build the league</p>
          <h1 id="hero-title">
            <span>Front Office,</span>
            <span>Ranked</span>
          </h1>
        </div>
      </section>

      <section class="premise" aria-labelledby="premise-title">
        <div class="premise__label">
          <span>01</span>
          <p>The premise</p>
        </div>
        <div class="premise__copy">
          <p class="eyebrow">Welcome to the front office</p>
          <h2 id="premise-title">Players get a box score. Decision-makers should, too.</h2>
          <div class="premise__columns">
            <p>
              Front Office, Ranked measures the player value connected to an executive’s
              drafts, trades, and signings. It turns decades of roster decisions into one
              explorable record—without pretending every move happens in a vacuum.
            </p>
            <p>
              Start with the executives running teams now, switch to the full historical
              archive, and choose between BPM and VORP. The score is the entry point; the
              category report card shows how each front office got there.
            </p>
          </div>
        </div>
      </section>

      <div id="rankings">
        <RankingsExplorer executives={executives} basePath={basePath} client:load />
      </div>

      <section class="methodology" id="methodology" aria-labelledby="methodology-title">
        <div class="methodology__number">02</div>
        <div class="methodology__body">
          <p class="eyebrow">Read the fine print</p>
          <h2 id="methodology-title">What these rankings measure</h2>
          <div class="methodology__grid">
            <article>
              <span>01</span>
              <h3>Moves become value</h3>
              <p>
                Draft picks, trades, and free-agent signings are connected to the BPM and
                VORP generated by the players involved during the relevant tenure.
              </p>
            </article>
            <article>
              <span>02</span>
              <h3>Context becomes categories</h3>
              <p>
                Each transaction type receives totals, ratings, percentiles, and letter
                grades so one giant cumulative number does not hide how an executive works.
              </p>
            </article>
            <article>
              <span>03</span>
              <h3>Samples matter</h3>
              <p>
                Executives with too few qualifying moves keep nullable ratings. The site
                labels those gaps instead of treating missing evidence as zero performance.
              </p>
            </article>
          </div>
          <aside>
            <strong>Snapshot provenance</strong>
            <span>{metadata.runId}</span>
            <span>{metadata.rowCount} executives · {metadata.activeCount} active</span>
            <span>Player input: {metadata.inputTable.split(".").at(-1)}</span>
            <span>Draft data through {metadata.draftEndYear}</span>
          </aside>
        </div>
      </section>
    </main>

    <footer>
      <a class="wordmark" href={basePath}><span>The</span> Grunfeld</a>
      <p>
        An independent fan project. Not affiliated with The Ringer, the NBA, or any NBA
        team. Rankings are analytical estimates, not statements of fact.
      </p>
      <a href="https://github.com/mcoirad/the-grunfeld">Source on GitHub</a>
    </footer>
  </body>
</html>
